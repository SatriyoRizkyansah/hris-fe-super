# URL dasar backend untuk request browser.
# Kosongkan selama template belum memakai backend.
NEXT_PUBLIC_API_BASE_URL=

# URL backend untuk route handler/server-side Next.js.
# Jangan pakai prefix NEXT_PUBLIC_ untuk secret atau endpoint internal.
API_BASE_URL=

# Unit yang dapat memproses validasi proyek (samakan dengan ENV backend).
NEXT_PUBLIC_UNIT_KODE_KABAG=ORG-UMUM
NEXT_PUBLIC_UNIT_KODE_KEUANGAN=ORG-UMUM-RENCANA-KEUANGAN
NEXT_PUBLIC_UNIT_KODE_LAYANAN=ORG-PENGEMBANGAN-LAYANAN
